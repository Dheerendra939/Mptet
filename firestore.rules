rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'qzquiz50@gmail.com' ||
        request.auth.token.email.matches('(?i)^qzquiz50@gmail\\.com$')
      );
    }

    // 1. User Purchases Collection
    match /UserPurchases/{purchaseId} {
      // Anyone can read purchase records to check unlocked status
      allow read: if true;
      // Logged-in users or guest purchasers can create a purchase record
      allow create: if true;
      // Only admin can modify or delete purchase records
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // 2. Custom Mock Tests Catalog
    match /CustomMockTests/{testId} {
      // Anyone can read and list custom mock tests
      allow read: if true;
      // Logged-in users or admin can create custom tests
      allow create: if isSignedIn();
      // Admin or author can update/delete
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && resource.data.authorId == request.auth.uid));
    }

    // 3. Promoters Collection
    match /Promoters/{promoterUserId} {
      // Anyone can read promoters list (to verify promo codes)
      allow read: if true;
      // Users can register as promoter for their own user ID
      allow create: if isSignedIn() && request.auth.uid == promoterUserId;
      // Admin or owner can update
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == promoterUserId);
      allow delete: if isSignedIn() && isAdmin();
    }

    // 4. Withdrawal Requests Collection
    match /WithdrawalRequests/{requestId} {
      // Anyone can read withdrawal status
      allow read: if true;
      // Logged-in promoters can request withdrawals
      allow create: if isSignedIn();
      // Admin can update status (approve/reject), owner or admin can update
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // 5. Leaderboard Entries Collection
    match /Leaderboards/{entryId} {
      // Anyone can view the leaderboard
      allow read: if true;
      // Anyone / logged-in users can submit their test scores
      allow create, update: if true;
      allow delete: if isSignedIn() && isAdmin();
    }

    // 6. Platform Settings Collection
    match /Settings/{settingId} {
      // Anyone can read platform pricing, discount, and commission settings
      allow read: if true;
      // Only admin can update settings
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    // 7. Users Collection
    match /Users/{userId} {
      // Public profiles / User registry
      allow read: if true;
      // User can manage their profile, admin has full control
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && isAdmin();
    }

    // 8. Email Broadcasts History
    match /EmailBroadcasts/{broadcastId} {
      // Admin can manage email broadcast history, users can read
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    // 9. Connectivity test
    match /test/{docId} {
      allow read, write: if true;
    }

    // 10. Site Analytics & Visitor Tracking
    match /SiteAnalytics/{docId} {
      // Public site visits track aggregate counts
      allow read, write: if true;
    }

    match /SiteDailyStats/{dateId} {
      // Daily unique visitor and pageview stats
      allow read, write: if true;
    }

    match /VisitorEvents/{eventId} {
      // Page visit activity log
      allow read, write: if true;
    }
  }
}
